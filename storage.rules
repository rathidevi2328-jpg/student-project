rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow users to upload profile pictures up to 5MB, image types only
    match /profiles/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == userId || 
        // Admin override
        request.auth.token.role == 'admin'
      ) && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Biometric face templates (only JSON/text representation, never raw video)
    match /biometrics/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin');
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin')
        && request.resource.size < 100 * 1024
        && request.resource.contentType.matches('application/json|text/plain');
    }
  }
}
